    USER {
        int UserID PK
        string Username
        string Email
        string Role "Buyer/Seller/Admin"
        string Status "Active/Locked"
    }
    ADDRESS {
        int AddressID PK
        int UserID FK
    }
    CART {
        int CartID PK
        int BuyerID FK
    }
    CART_ITEM {
        int CartItemID PK
        int CartID FK
        int ProductID FK
        int Quantity
    }
    SHOP {
        int ShopID PK
        int SellerID FK
        string ShopName
    }
    CATEGORY {
        int CategoryID PK
        string CategoryName
    }
    PRODUCT {
        int ProductID PK
        int ShopID FK
        int CategoryID FK
        string ProductName
        decimal Price
        int Stock
        string ApprovalStatus "Pending/Approved"
    }
    PRODUCT_SPECIFICATION {
        int SpecID PK
        int ProductID FK
        string AttributeName
    }
    ORDER {
        int OrderID PK
        int BuyerID FK
        int ShopID FK
        datetime OrderDate
        decimal TotalAmount
        string OrderStatus "Shipping/Delivered/Canceled"
    }
    ORDER_ITEM {
        int OrderItemID PK
        int OrderID FK
        int ProductID FK
        int Quantity
    }
    PAYMENT {
        int PaymentID PK
        int OrderID FK
        string PaymentMethod "VNPay"
        string PaymentStatus
    }
    REVIEW {
        int ReviewID PK
        int BuyerID FK
        int ShopID FK
        int ProductID FK
        int Rating
    }
